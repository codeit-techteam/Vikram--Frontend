# Customer app API (Expo inlines EXPO_PUBLIC_* at Metro start — always restart with cache clear after changes):
#   npx expo start -c
#
# Use DigitalOcean for catalog/checkout with real product IDs (recommended until payments are deployed):
EXPO_PUBLIC_API_URL=https://bajriwala-backend-zkuxd.ondigitalocean.app/api/v1
EXPO_PUBLIC_APP_ENV=production
#
# For local Nest + Razorpay Test Mode only (comment out EXPO_PUBLIC_API_URL above):
# Products must exist in your LOCAL database — DO product UUIDs will show "Product not found".
# EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
