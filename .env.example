# API base URL (Expo inlines EXPO_PUBLIC_* at Metro start — restart with `npx expo start -c` after changes).
#
# Recommended (production catalog on DigitalOcean):
EXPO_PUBLIC_API_URL=https://bajriwala-backend-zkuxd.ondigitalocean.app/api/v1
EXPO_PUBLIC_APP_ENV=production
#
# Local Nest for Razorpay Test Mode (leave EXPO_PUBLIC_API_URL unset to auto-use Mac LAN IP:8000):
# # EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_APP_ENV=development
# Warning: cart product UUIDs are per-database. Switching hosts clears the cart automatically.
#
# Google Maps key for native map rendering (Maps SDK for Android / iOS).
# This value ships inside the app binary, so it must be restricted in Google Cloud
# Console to the Android package + SHA-1 and the iOS bundle ID (com.bajriwala.app).
# Geocoding and Places are proxied through the backend, which holds its own server key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Push notifications use FCM via the backend. No Firebase secrets belong in this app.
# A development or production build is required (Expo Go cannot receive Android FCM).
# google-services.json must stay in the repo root and is referenced from app.json.

# Razorpay Key Secret must NEVER be added here. The backend returns the public Key ID
# at checkout. Native Razorpay checkout requires a development/EAS build.
