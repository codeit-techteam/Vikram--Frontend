# Production / staging API (DigitalOcean App Platform).
# Restart Metro after changing this value (Expo inlines EXPO_PUBLIC_* at bundler start).
# For local backend instead: http://localhost:8000/api/v1 (or your Mac LAN IP on a device).
EXPO_PUBLIC_API_URL=https://bajriwala-backend-zkuxd.ondigitalocean.app/api/v1
EXPO_PUBLIC_APP_ENV=production
# Google Maps / Places (Places Autocomplete + Geocoding + reverse geocode)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Push notifications use FCM via the backend. No Firebase secrets belong in this app.
# A development or production build is required (Expo Go cannot receive Android FCM).
# google-services.json must stay in the repo root and is referenced from app.json.
