# Simulator / local: localhost works.
# Physical device: use your Mac LAN IP from `ipconfig getifaddr en0`
# Restart Metro after changing this value (Expo inlines EXPO_PUBLIC_* at bundler start).
EXPO_PUBLIC_API_URL=http://192.168.0.104:8000/api/v1
EXPO_PUBLIC_APP_ENV=development
# Google Maps / Places (Places Autocomplete + Geocoding + reverse geocode)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
