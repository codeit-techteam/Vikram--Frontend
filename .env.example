# Copy to `.env` for local Metro. Never commit `.env`.
# Cloud builds read the same names from Expo → Environment variables.

# API base URL (inlined into the JS bundle — restart Metro after changes):
#   npx expo start -c
EXPO_PUBLIC_API_URL=https://bajriwala-backend-zkuxd.ondigitalocean.app/api/v1
EXPO_PUBLIC_APP_ENV=production

# Local Nest for Razorpay Test Mode (leave EXPO_PUBLIC_API_URL unset to auto-use Mac LAN IP:8000):
# EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_APP_ENV=development

# Native Maps SDK key (AndroidManifest / Info.plist via app.config.js).
# Prefer this name in Expo dashboard (Sensitive). Restrict in Google Cloud to
# Android package + SHA-1 and iOS bundle ID com.bajriwala.app.
GOOGLE_MAPS_API_KEY=

# Same key for JS geocoding helpers (also inlined into the client bundle).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Push notifications use FCM via the backend. No Firebase secrets belong here.
# google-services.json stays at the repo root and is referenced from app.config.js.

# Razorpay Key Secret must NEVER be added here. The backend returns the public Key ID.
