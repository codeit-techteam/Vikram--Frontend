{
  "expo": {
    "name": "Bajriwala",
    "slug": "bajriwala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "bajriwala",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEB623"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dhoodhwala.frontend"
    },
    "android": {
      "package": "com.dhoodhwala.frontend",
      "adaptiveIcon": {
        "backgroundColor": "#FEB623",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bajriwala to access your location for delivery site setup."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
