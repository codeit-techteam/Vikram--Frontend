{
  "expo": {
    "name": "Bajriwala",
    "slug": "bajriwala",
    "owner": "sumit.codeit1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bajriwala",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bajriwala.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCg7PUYhfoXMUPHXLjMv4bEXoCawot3GZI"
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Bajriwala to use speech recognition for voice search.",
        "NSMicrophoneUsageDescription": "Allow Bajriwala to use your microphone for voice search.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.bajriwala.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCg7PUYhfoXMUPHXLjMv4bEXoCawot3GZI"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#FEB623",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FEB623",
          "defaultChannel": "bajriwala-default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bajriwala to access your location for delivery site setup.",
          "locationWhenInUsePermission": "Allow Bajriwala to use your location while using the app to set delivery sites."
        }
      ],
      "expo-build-properties",
      "expo-video",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Bajriwala to use your microphone for voice search.",
          "speechRecognitionPermission": "Allow Bajriwala to use speech recognition for voice search."
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FEB623"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5fbb9da-1048-4133-86b3-258efb665369"
      }
    }
  }
}
