{
  "expo": {
    "name": "Bajriwala",
    "slug": "bajriwala",
    "owner": "vikramsahrawat09s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-ivory.png",
    "scheme": "bajriwala",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCF7E4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bajriwala.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCg7PUYhfoXMUPHXLjMv4bEXoCawot3GZI"
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Bajriwala to use speech recognition for voice search.",
        "NSMicrophoneUsageDescription": "Allow Bajriwala to use your microphone for voice search.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.bajriwala.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCg7PUYhfoXMUPHXLjMv4bEXoCawot3GZI"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#FCF7E4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background-ivory.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FCF7E4"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FEB623",
          "defaultChannel": "bajriwala-default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bajriwala to access your location for delivery site setup.",
          "locationWhenInUsePermission": "Allow Bajriwala to use your location while using the app to set delivery sites."
        }
      ],
      "expo-build-properties",
      "expo-video",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Bajriwala to use your microphone for voice search.",
          "speechRecognitionPermission": "Allow Bajriwala to use speech recognition for voice search."
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FCF7E4",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#FCF7E4"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Bajriwala to use your microphone for voice search.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0350eea9-fe5d-4623-b7bd-3d3ddf1ad568"
      }
    }
  }
}
